# Node specs format:
# name|api_key|db_uri|db_type|db_label
#
# BEACH-schema variant of nodes.lung1.env, generated via
# `data/generate_beach_data.py` for the 20kChallengeVantage6 logistic
# regression algorithm (which requires patient_t_stage/patient_n_stage/
# patient_m_stage/patient_overall_stage/year_of_diagnosis/vital_status/
# interval_diagnosis_to_last_visit_in_days columns).
#
# Not wired into infra.sh by default — use it by pointing NODES_CONFIG at
# this file, e.g.:
#   NODES_CONFIG=./nodes.beach.env ./infra.sh preflight
#
# Same api_keys as nodes.lung1.env so these map onto the same alpha/beta/gamma/theta
# organizations already imported on the running server.

alpha|844a7d92-1cc9-4856-bf33-0613252d5b3c|../data/datavalgen/data/alpha.csv|csv|default
beta|57143784-19ef-456b-94c9-ba68c8cb079b|../data/datavalgen/data/beta.csv|csv|default
gamma|57143784-19ef-456b-94c9-ba68c8cb079c|../data/datavalgen/data/gamma.csv|csv|default
theta|a3f21c84-7e45-4b29-9d16-1f82e3c05d7a|../data/datavalgen/data/theta.csv|csv|default
