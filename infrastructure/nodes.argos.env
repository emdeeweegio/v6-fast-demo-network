# Node specs format:
# name|api_key|db_uri|db_type|db_label|extra_db_uri|extra_db_type|extra_db_label
#
# The last three fields are optional and add a second, read-only *folder*
# database to the node — used here to bind-mount each org's NIfTI slice
# folder into algorithm containers at /mnt/<extra_db_label> (see
# argos_cnn.py's ct_path/gt_path columns, which point at /mnt/nifti/...).
# It is not requested via `databases=[...]` in run_study.py, so vantage6's
# @data() decorator never tries to parse it as tabular data — it's just a
# filesystem mount that nib.load() reads directly.
#
# argos_cnn algorithm's data manifest for federated ModResNet CT/GTV
# segmentation training. Use this by pointing NODES_CONFIG at this file:
#   NODES_CONFIG=./nodes.argos.env ./infra.sh preflight
# or via the shortcut:
#   ./infra.sh up_argos
#
# Same api_keys as nodes.lung1.env so these map onto the same alpha/beta/gamma/theta
# organizations already imported on the running server.

alpha|844a7d92-1cc9-4856-bf33-0613252d5b3c|../data/argos/alpha.csv|csv|default|../data/argos/nifti/alpha|folder|nifti
beta|57143784-19ef-456b-94c9-ba68c8cb079b|../data/argos/beta.csv|csv|default|../data/argos/nifti/beta|folder|nifti
gamma|57143784-19ef-456b-94c9-ba68c8cb079c|../data/argos/gamma.csv|csv|default|../data/argos/nifti/gamma|folder|nifti
theta|a3f21c84-7e45-4b29-9d16-1f82e3c05d7a|../data/argos/theta.csv|csv|default|../data/argos/nifti/theta|folder|nifti
